{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-tdd.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-tests-before-commit.ts\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",

      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",

      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.test)",
      "Write(**/*credential*)",
      "Write(**/*secret*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pfx)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)",
      "Write(**/.npmrc)",
      "Write(**/.netrc)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.config/gcloud/**)",

      "Bash(cat *.env*)",
      "Bash(cat *credential*)",
      "Bash(cat *secret*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * *.env*)",
      "Bash(rg * *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(Select-String * *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(rm *.env*)",
      "Bash(source *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Select-String * *.env*)",
      "PowerShell(Copy-Item *.env*)",
      "PowerShell(Move-Item *.env*)",
      "PowerShell(Remove-Item *.env*)",
      "PowerShell(Set-Content *.env*)",
      "PowerShell(Add-Content *.env*)",
      "PowerShell(Get-ChildItem Env:*)",
      "PowerShell(dir Env:*)"
    ]
  }
}
